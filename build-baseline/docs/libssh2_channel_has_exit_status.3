.TH libssh2_channel_has_exit_status 3 "2026-11-14" libssh2
.SH NAME
libssh2_channel_has_exit_status \- check if an exit status arrived
.SH SYNOPSIS
.nf
#include <libssh2.h>

int libssh2_channel_has_exit_status(LIBSSH2_CHANNEL *channel);
.fi
.SH DESCRIPTION
\fIchannel\fP \- Closed channel stream to query.

Report whether the remote host sent an \fIexit\-status\fP request for the named
channel. \fIlibssh2_channel_get_exit_status(3)\fP returns 0 both for a real exit
status of 0 and for a channel that never received the request, so it cannot
tell the two apart on its own. A server may close a channel without sending
the request, for example when OpenSSH enforces \fIChannelTimeout\fP, and the
command then keeps running on the remote host.
.SH RETURN VALUE
Returns 1 if an \fIexit\-status\fP request was received for the channel,
otherwise 0. Also returns 0 when \fIchannel\fP is NULL.
.SH EXAMPLE
.nf
if(libssh2_channel_close(channel) == 0 &&
   libssh2_channel_has_exit_status(channel))
    exitcode = libssh2_channel_get_exit_status(channel);
.fi
.SH AVAILABILITY
Added in libssh2 1.12.0
.SH SEE ALSO
.BR libssh2_channel_get_exit_status(3)
