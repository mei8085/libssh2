.\" generated by cd2nroff 0.1 from libssh2_build_options.md
.TH libssh2_build_options 3 "2026-11-14" libssh2
.SH NAME
libssh2_build_options \- return build\-time options
.SH SYNOPSIS
.nf
#include <libssh2.h>

const char *libssh2_build_options(void);
.fi
.SH DESCRIPTION
Return the full list of options available at build time, along with their
enabled/disabled statuses.
.SH RETURN VALUE
A read\-only, space\-separated list of key:value pairs describing build options.
Options use \fIon\fP or \fIoff\fP, except:

\fIcrypto\fP, which reports one of these values:
\fIAWS\-LC\fP, \fIBoringSSL\fP, \fILibgcrypt\fP, \fILibreSSL\fP, \fImbedTLS\fP, \fIOpenSSL\fP,
\fIOpenSSL/1.1.1\fP, \fIOS400QC3\fP, \fIWinCNG\fP, \fIwolfSSL\fP.

\fIagent\fP, which is listed for each supported agent backend:
\fIPageant\fP (Windows\-specific), \fIOpenSSH\fP (Windows\-specific), \fIUnix\fP.
.SH EXAMPLE
.nf
printf("libssh2 build options: %s", libssh2_build_options());
.fi
.SH AVAILABILITY
Added in libssh2 1.12.0
.SH SEE ALSO
.BR libssh2_crypto_engine(3),
.BR libssh2_version(3)
